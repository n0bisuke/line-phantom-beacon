// 秘密情報 + 端末固有設定のひな形。実ファイル include/secrets.h は .gitignore 済み。
//    cp include/secrets.h.example include/secrets.h
// してから実値を書く。
#pragma once

// ---- Wi-Fi 複数登録 (ESPectre が CSI を取るため 2.4GHz 802.11n 必須) ----
// 切れたときだけ最強の登録 AP に切り替える(繋がっている間は切り替えない)。
// SSID が空の行はスキップされる。
#define WIFI_CREDENTIALS \
  { "your-ssid-2.4g", "your-password" }, \
  { "", "" }  // 予備(テザリング等)。不要ならこのまま

// ---- LINE Simple Beacon (Phase 2〜) ----
// HWID: LINE Official Account Manager (https://manager.line.biz/beacon/register) で発行。
// 16進10文字 (5バイト)。自身のBotに発行された HWID 以外は使わないこと。
#define LINE_BEACON_HWID_HEX "0000000000"
// Device Message: 開発者が自由に使える最大13バイト(16進26文字)。未使用なら "" 空文字。
// 例: "20170228" / "0032006900FAFFFF000199FF88"
#define LINE_BEACON_DM_HEX ""

// ---- LINE Messaging API 直接 push (Phase 5・サーバーレス) ----
// トークンはここに置き、Git にコミットしない。漏れたら LINE Developers コンソールでローテーション。
#define LINE_CHANNEL_TOKEN ""
#define LINE_USER_ID ""
// 通知に付ける端末名
#define DEVICE_ID "atoms3-desk"

// ---- 疑似イベントしきい値 (Phase 4〜) ----
#define PSEUDO_LEAVE_MS 10000UL      // 10秒間動きがなければ push
#define PSEUDO_CONTINUED_MS 20000UL  // 20秒間: 「継続して動きがありません」push
#define SLEEP_SUSPECTED_MS 30000UL   // 30秒間: 寝落ち push(これ以降は push しない)
