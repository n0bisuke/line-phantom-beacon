// 秘密情報 + 端末固有設定のひな形。実ファイル include/secrets.h は .gitignore 済み。
//    cp include/secrets.h.example include/secrets.h
// してから実値を書く。
#pragma once

// ---- Wi-Fi (ESPectre が CSI を取るため 2.4GHz 802.11n 必須) ----
#define WIFI_SSID "your-ssid-2.4g"
#define WIFI_PASSWORD "your-password"

// ---- LINE Simple Beacon (Phase 2〜) ----
// HWID: LINE Official Account Manager (https://manager.line.biz/beacon/register) で発行。
// 16進10文字 (5バイト)。自身のBotに発行された HWID 以外は使わないこと。
#define LINE_BEACON_HWID_HEX "0000000000"
// Device Message: 開発者が自由に使える最大13バイト(16進26文字)。未使用なら "" 空文字。
// 例: "20170228" / "0032006900FAFFFF000199FF88"
#define LINE_BEACON_DM_HEX ""

// ---- 中継サーバー (Phase 5〜) ----
// LINE チャネルアクセストークンは ESP32 側に持たない。Node.js 中継の URL のみ。
#define RELAY_SERVER_URL "http://192.168.1.100:3000/events"

// ---- 疑似イベントしきい値 (Phase 4〜) ----
#define PSEUDO_LEAVE_MS 30000UL   // 30秒間動きがなければ疑似 leave
#define SLEEP_SUSPECTED_MS 180000UL  // 3分間動きがなければ寝落ち疑い
